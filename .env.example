# Discord Bot Token (必須)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Gemini API Key (DM自動返信機能用)
GEMINI_API_KEY=your_gemini_api_key_here

# Bot管理者のDiscord User ID（カンマ区切り）
BOT_ADMIN_IDS=123456789012345678,987654321098765432

# Ricochet Robots: 指定チャンネルでは11手以上をスキップ（カンマ区切り）
RR_SKIP_11PLUS_CHANNEL_IDS=1467456349767208982
# Ricochet Robots 実戦モード(starttime): 最短未満の宣言を拒否
RR_REAL60_REJECT_BELOW_OPTIMAL=true
# Ricochet Robots 実戦モード(starttime): 最短手が宣言されたら即終了
RR_REAL60_END_ON_OPTIMAL=true

# Google Calendar -> Discord Event 同期機能
ENABLE_CALENDAR_SYNC=false
# 起動直後の初回は一方向（Google -> Discord/Firestore）
# 2回目以降の定期同期は双方向
# 実験用に /sync-bidir で即時双方向同期も可能
FIREBASE_PROJECT_ID=your_firebase_project_id
DISCORD_GUILD_ID=your_discord_guild_id

# 単一ターゲット設定（従来）
GOOGLE_CALENDAR_ID=your_google_calendar_id
DISCORD_EVENT_ANNOUNCE_CHANNEL_ID=your_discord_announce_channel_id

# 複数ターゲット設定（PLAY / CREATE）
GOOGLE_CALENDAR_ID_PLAY=your_play_calendar_id
DISCORD_EVENT_ANNOUNCE_CHANNEL_ID_PLAY=your_play_announce_channel_id
GOOGLE_CALENDAR_ID_CREATE=your_create_calendar_id
DISCORD_EVENT_ANNOUNCE_CHANNEL_ID_CREATE=your_create_announce_channel_id

CAL_SYNC_INTERVAL_MINUTES=15
CAL_SYNC_LOOKAHEAD_DAYS=90
CAL_SYNC_ANNOUNCE_TIMEZONE=Asia/Tokyo
CAL_SYNC_ANNOUNCE_HOUR=9
FIRESTORE_COLLECTION_CALENDAR_SYNC=calendar_sync_events

# 認証情報（どちらか）
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
